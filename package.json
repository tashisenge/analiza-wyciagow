{
  "name": "analiza-wyciagow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node scripts/ensure-single-dev.mjs && rm -rf .next && next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && DIRECT_URL=\"${DIRECT_URL:-${DATABASE_URL_UNPOOLED:-$POSTGRES_URL_NON_POOLING}}\" prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --project=smoke-public --project=setup --project=smoke-app --project=smoke-import",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "demo:seed": "npx tsx scripts/seed-demo.ts",
    "ai:map": "npx tsx scripts/apply-mbank-map.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.52.0",
    "@prisma/client": "^6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^3.2.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "^16.2.6",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "postcss": "^8.5.15",
    "prettier": "^3.5.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.3",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ],
    "src/lib/**/*.ts": [
      "vitest related --run"
    ],
    "tests/**/*.ts": [
      "vitest related --run"
    ]
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.2.1",
    "next": "^15.5.18",
    "next-auth": "^5.0.0-beta.25",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "zod": "^4.4.3"
  }
}
